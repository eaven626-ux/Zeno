    "Chat": {
      "title": "Chat",
      "description": "A conversation container (saved messages, direct message, group, or channel)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
