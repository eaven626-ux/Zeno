  "firestore": {
    "/users_public/{userId}": {
      "schema": { "$ref": "#/entities/PublicUser" },
      "description": "Publicly searchable user profiles (display name, username, avatar, bio, lastSeen) without PII"
    },
    "/users_private/{userId}": {
      "schema": { "$ref": "#/entities/PrivateUser" },
      "description": "Owner-only private user preferences and email"
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/Chat" },
      "description": "Canonical metadata for Saved Messages, Direct Messages, Groups, and Channels"
    },
    "/chats/{chatId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/ChatMember" },
      "description": "Membership and roles for each chat"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages inside a chat"
    },
    "/chats/{chatId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/ChannelComment" },
      "description": "Comments posted by subscribers on channel messages"
    },
    "/chats/{chatId}/file_chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/FileChunk" },
      "description": "Chunked data URL segments for large file and audio attachments"
    },
    "/chats/{chatId}/reactions/{reactionId}": {
      "schema": { "$ref": "#/entities/MessageReaction" },
      "description": "Per-user reactions on messages inside a chat"
    },
    "/chats/{chatId}/poll_votes/{voteId}": {
      "schema": { "$ref": "#/entities/PollVote" },
      "description": "Per-user votes on poll messages inside a chat"
    },
    "/user_chats/{userId}/items/{chatId}": {
      "schema": { "$ref": "#/entities/UserChatItem" },
      "description": "Personal chat list entries and folder/pin/mute settings per user"
    },
    "/usernames/{username}": {
      "schema": { "$ref": "#/entities/UsernameReservation" },
      "description": "Protected unique username ownership records guaranteeing exclusive @username claims"
    },
    "/user_blocks/{blockId}": {
      "schema": { "$ref": "#/entities/UserBlock" },
      "description": "User block records indexed by {blockerUid}_{blockedUid} enforcing mutual direct messaging blocks"
    },
    "/sticker_packs/{packId}": {
      "schema": { "$ref": "#/entities/StickerPack" },
      "description": "Custom sticker packs owned by individual users"
    },
    "/sticker_packs/{packId}/stickers/{stickerId}": {
      "schema": { "$ref": "#/entities/CustomSticker" },
      "description": "Custom stickers belonging to a specific user-owned sticker pack"
    },
    "/chats/{chatId}/scheduled_messages/{scheduledId}": {
      "schema": { "$ref": "#/entities/ScheduledMessage" },
      "description": "Sender-private queue of scheduled messages inside a chat"
    },
    "/phone_numbers/{phoneDigits}": {
      "schema": { "$ref": "#/entities/PhoneLookup" },
      "description": "Exact phone-number lookup records (list forbidden) for finding users by phone number"
    },
    "/invite_links/{inviteCode}": {
      "schema": { "$ref": "#/entities/InviteLink" },
      "description": "Shareable group and channel invite link records"
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/Story" },
      "description": "24-hour user status stories"
    },
    "/stories/{storyId}/views/{viewerId}": {
      "schema": { "$ref": "#/entities/StoryView" },
      "description": "Story view tracking records readable by the story owner"
    },
    "/stories/{storyId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/StoryChunk" },
      "description": "Chunked video media segments for video stories"
    },
    "/calls/{callId}": {
      "schema": { "$ref": "#/entities/CallSession" },
      "description": "WebRTC 1-on-1 audio/video call signaling sessions"
    },
    "/calls/{callId}/callerCandidates/{candidateId}": {
      "schema": { "$ref": "#/entities/CallCandidate" },
      "description": "Caller ICE candidates for a WebRTC call session"
    },
    "/calls/{callId}/calleeCandidates/{candidateId}": {
      "schema": { "$ref": "#/entities/CallCandidate" },
      "description": "Callee ICE candidates for a WebRTC call session"
    }
  }
}
