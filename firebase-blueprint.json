      "title": "PublicUser",
      "description": "Publicly discoverable user profile without PII",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-z0-9_]+$"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 150000
        },
        "bio": {
          "type": "string",
          "maxLength": 200
        },
        "isDiscoverable": {
          "type": "boolean"
        },
        "lastSeen": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "username", "isDiscoverable", "lastSeen", "createdAt"]
    },
    "PrivateUser": {
      "title": "PrivateUser",
      "description": "Private user settings and PII isolated from public reads",
