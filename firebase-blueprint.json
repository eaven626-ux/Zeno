          "type": "integer",
          "description": "Self-destruct timer in seconds for new messages in private chats (0 = off)"
        },
        "inviteCode": {
          "type": "string",
          "maxLength": 32,
          "description": "Active invite code for joining a group or channel via link or QR"
        },
        "slowModeSeconds": {
          "type": "integer",
          "description": "Minimum interval in seconds between messages from non-admin members in groups"
        },
